universe=vanilla
executable=runjob_22.sh

jobconfmod = jobconfiganalysis_2022EE_Era_f

arguments= $(input_dir) $(output_file) $(stderr_file) $(jobconfmod)

output=logs/$(ClusterId).out
error=logs/$(ClusterId).err
log=logs/$(ClusterId).log

should_transfer_files=YES
transfer_input_files= .

when_to_transfer_output=ON_EXIT_OR_EVICT

request_cpus=1
request_memory=8 GB
request_disk= 50 GB



queue input_dir, output_file, stderr_file from Temp_1.txt 
