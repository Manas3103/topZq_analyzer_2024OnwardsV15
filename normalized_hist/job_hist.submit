universe=vanilla
executable=runjob_hist.sh
arguments= $(filename) $(crossection) 

output=logs/$(ClusterId).out
error=logs/$(ClusterId).err
log=logs/$(ClusterId).log

should_transfer_files=YES
transfer_input_files= create_normalized_histogram.C, histogram_data_whole.txt, runjob_hist.sh, DY_test.txt, 2022_MC_file.txt, 2022_MC_file_modified.txt
when_to_transfer_output=ON_EXIT_OR_EVICT

request_cpus=1
request_memory=8 GB
request_disk= 10 GB

queue filename, crossection from 2022_MC_file_modified.txt

