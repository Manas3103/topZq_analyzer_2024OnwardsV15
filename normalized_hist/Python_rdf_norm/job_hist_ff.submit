universe=vanilla
executable=runjob_hist_py.sh
output_mode = ff
json_file = hist_config_with_labels_ff.json
arguments= $(filename) $(crossection) $(sum_gen_weight) $(type) $(json_file) $(output_mode)

# Extract clean file name (without path and .root)
filetag = $Fnx(filename)

output = logs/$(filetag)_$(ClusterId)_$(Process).out
error  = logs/$(filetag)_$(ClusterId)_$(Process).err
log    = logs/$(filetag)_$(ClusterId).log

should_transfer_files=YES
transfer_input_files= runjob_hist_py.sh, create_hist_rdf.py, hist_config_with_labels_ff.json, 2024_ff_sample.txt
when_to_transfer_output=ON_EXIT_OR_EVICT

request_cpus=1
request_memory=8 GB
request_disk= 20 GB

queue filename, crossection, sum_gen_weight, type from 2024_ff_sample.txt 
