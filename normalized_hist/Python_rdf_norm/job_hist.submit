universe=vanilla
executable=runjob_hist_py.sh
arguments= $(filename) $(crossection) 

# Extract clean file name (without path and .root)
filetag = $(basename filename)

output = logs/$(filetag)_$(ClusterId).out
error  = logs/$(filetag)_$(ClusterId).err
log    = logs/$(filetag)_$(ClusterId).log

should_transfer_files=YES
transfer_input_files= runjob_hist_py.sh, create_hist_rdf.py, 2024_MC.txt, hist_config.json, 2024_MC_woLeptonCorrector.txt
when_to_transfer_output=ON_EXIT_OR_EVICT

request_cpus=1
request_memory=4 GB
request_disk= 20 GB

queue filename, crossection from 2024_MC_woLeptonCorrector.txt
