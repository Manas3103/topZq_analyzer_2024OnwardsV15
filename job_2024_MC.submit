universe=vanilla
executable=runjob_24.sh
+JobFlavour = "nextweek"
stream_output = True
stream_error  = True

jobconfmod = jobconfiganalysis_2024

arguments= $(input_dir) $(output_file) $(stderr_file) $(jobconfmod)

output = logs/$(ClusterId).$(Process).out
error  = logs/$(ClusterId).$(Process).err
log    = logs/$(ClusterId).log

should_transfer_files=YES
transfer_input_files= .

when_to_transfer_output=ON_EXIT_OR_EVICT

request_cpus=1
request_memory=8 GB
request_disk= 50 GB



queue input_dir, output_file, stderr_file from DataMC_txt/2024_summer/2024_MC_v15_woutput.txt
