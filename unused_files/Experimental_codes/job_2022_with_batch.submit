universe=vanilla
executable=runjob_22_updated.sh
arguments= $(input_dir) $(output_file) $(stderr_file) $(nJobs)

output=logs/$(ClusterId).out
error=logs/$(ClusterId).err
log=logs/$(ClusterId).log

should_transfer_files=YES
transfer_input_files= .

when_to_transfer_output=ON_EXIT_OR_EVICT

request_cpus=1
request_memory=8 GB
request_disk= 50 GB



queue input_dir, output_file, stderr_file, nJobs from Temp.txt
