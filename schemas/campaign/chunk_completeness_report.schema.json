{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "chunk_completeness_report"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "workflow": {
      "enum": [
        "main",
        "fakefactor"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "expected_count": {
      "type": "integer",
      "minimum": 0
    },
    "accepted_count": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string"
          },
          "attempt_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "chunk_id",
          "attempt_id",
          "status",
          "exit_code",
          "accepted"
        ],
        "additionalProperties": false
      }
    },
    "accepted_input_manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "accepted_merge_inputs"
        },
        "campaign_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "workflow": {
          "enum": [
            "main",
            "fakefactor"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "local_root": {
          "type": "string"
        },
        "plan_source": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "ordering": {
          "const": "ascending expected chunk index"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chunk_id": {
                "type": "string"
              },
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "attempt_id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "chunk_id",
              "index",
              "attempt_id",
              "path",
              "size_bytes",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "campaign_id",
        "dataset_id",
        "workflow",
        "status",
        "local_root",
        "plan_source",
        "ordering",
        "inputs"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "campaign_id",
    "dataset_id",
    "workflow",
    "status",
    "expected_count",
    "accepted_count",
    "issues",
    "attempts",
    "accepted_input_manifest"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
