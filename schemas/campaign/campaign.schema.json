{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "campaign"
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "failed",
        "incomplete",
        "validated"
      ]
    },
    "approval": {
      "enum": [
        "experimental",
        "approved",
        "rejected"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "year": {
      "const": 2024
    },
    "data_eras": {
      "type": "array",
      "items": {
        "enum": [
          "B",
          "C",
          "D",
          "E",
          "F",
          "G",
          "H",
          "I"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "repository",
        "branch",
        "commit",
        "dirty",
        "changes"
      ],
      "additionalProperties": false
    },
    "plotting_source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "repository",
        "branch",
        "commit",
        "dirty",
        "changes"
      ],
      "additionalProperties": false
    },
    "configurations": {
      "type": "object",
      "properties": {
        "main": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "config": {
              "type": "object"
            },
            "procflags": {
              "type": "object"
            }
          },
          "required": [
            "path",
            "sha256",
            "config",
            "procflags"
          ],
          "additionalProperties": false
        },
        "fakefactor": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "config": {
              "type": "object"
            },
            "procflags": {
              "type": "object"
            }
          },
          "required": [
            "path",
            "sha256",
            "config",
            "procflags"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "main",
        "fakefactor"
      ],
      "additionalProperties": false
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "dataset.schema.json"
      }
    },
    "declared": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "state": {
            "enum": [
              "declared",
              "verified",
              "unknown",
              "unavailable"
            ]
          },
          "value": {},
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "state",
          "value",
          "evidence",
          "reason"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "unknown",
                    "unavailable"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "verified"
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "not": {
                    "type": "null"
                  }
                }
              }
            }
          }
        ]
      }
    },
