{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "chunk_inventory"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "workflow": {
      "enum": [
        "main",
        "fakefactor"
      ]
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "attempt": {
            "type": "object",
            "properties": {
              "schema_version": {
                "const": 1
              },
              "kind": {
                "const": "attempt"
              },
              "status": {
                "enum": [
                  "planned",
                  "running",
                  "failed",
                  "incomplete",
                  "validated"
                ]
              },
              "approval": {
                "enum": [
                  "experimental",
                  "approved",
                  "rejected"
                ]
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "attempt_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "campaign_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "workflow": {
                "enum": [
                  "main",
                  "fakefactor"
                ]
              },
              "source": {
                "type": "object",
                "properties": {
                  "repository": {
                    "type": "string"
                  },
                  "branch": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "commit": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "dirty": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "changes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "repository",
                  "branch",
                  "commit",
                  "dirty",
                  "changes"
                ],
                "additionalProperties": false
              },
              "declared": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "enum": [
                        "declared",
                        "verified",
                        "unknown",
                        "unavailable"
                      ]
                    },
                    "value": {},
                    "evidence": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "state",
                    "value",
                    "evidence",
                    "reason"
                  ],
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "state": {
                            "enum": [
                              "unknown",
                              "unavailable"
                            ]
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": "null"
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "state": {
                            "const": "verified"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "evidence": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "not": {
                              "type": "null"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "runtime_effective": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "enum": [
                        "verified",
                        "unknown",
                        "unavailable"
                      ]
                    },
                    "value": {},
                    "evidence": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "state",
                    "value",
                    "evidence",
                    "reason"
                  ],
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "state": {
                            "enum": [
                              "unknown",
                              "unavailable"
                            ]
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": "null"
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "state": {
                            "const": "verified"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "evidence": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "not": {
                              "type": "null"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "environment": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "enum": [
                        "declared",
                        "verified",
                        "unknown",
                        "unavailable"
                      ]
                    },
                    "value": {},
                    "evidence": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "state",
                    "value",
                    "evidence",
                    "reason"
                  ],
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "state": {
                            "enum": [
                              "unknown",
                              "unavailable"
                            ]
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": "null"
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "state": {
                            "const": "verified"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "evidence": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "not": {
                              "type": "null"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "ordered_inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "artifact_manifests": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "schema_version",
              "kind",
              "status",
              "approval",
              "created_at",
              "attempt_id",
              "campaign_id",
              "workflow",
              "source",
              "declared",
              "runtime_effective",
              "environment",
              "ordered_inputs",
              "command",
              "exit_code",
              "artifact_manifests"
            ],
            "additionalProperties": false,
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "attempt.schema.json"
          },
          "dataset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "accepted": {
            "type": "boolean"
          },
          "output": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "validation": {
                "type": "object",
                "properties": {
                  "state": {
                    "enum": [
                      "verified",
                      "unknown",
                      "declared"
                    ]
                  },
                  "result": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "UNKNOWN"
                    ]
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "state",
                  "result",
                  "evidence"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "path",
              "size_bytes",
              "sha256",
              "validation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "chunk_id",
          "index",
          "attempt",
          "dataset_id",
          "accepted",
          "output"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "campaign_id",
    "dataset_id",
    "workflow",
    "attempts"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
