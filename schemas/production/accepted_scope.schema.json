{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "accepted_output_scope"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "selector": {
      "enum": [
        "mc",
        "data",
        "full",
        "explicit"
      ]
    },
    "campaign": {
      "type": "object"
    },
    "campaign_record": {
      "type": "string"
    },
    "campaign_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflow": {
      "const": "main"
    },
    "expected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "dataset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "datatype": {
            "enum": [
              "mc",
              "data"
            ]
          },
          "chunk_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "ordered_inputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "config": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "processing_schema_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "required": [
          "dataset_id",
          "datatype",
          "chunk_id",
          "index",
          "ordered_inputs",
          "config",
          "profile",
          "processing_schema_id"
        ],
        "additionalProperties": false
      }
    },
    "campaign_complete_scope": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "scope_id",
    "selector",
    "campaign",
    "campaign_record",
    "campaign_sha256",
    "workflow",
    "expected",
    "campaign_complete_scope"
  ],
  "additionalProperties": false
}
